class RequisitionSystem:

    requisition_counter = 10000
    all_requisition = []

    def __init__(self, date, staff_id, staff_name, items):

        self.date = date
        self.staff_id = staff_id
        self.staff_name = staff_name
        self.items = items

        self.requisition_id = None
        self.total = 0
        self.status = "Pending"
        self.approval_reference = "Not available"

    def add_requisition(self):
        print("Enter staff information:")

        self.date = input("Date (DD-MM-YYYY): ")
        self.staff_id = input("Staff ID: ")
        self.staff_name = input("Staff Name: ")

        self.items = []
        self.total = 0

        print("Enter requisition items:")

        while True:
            item_name = input("Item name: ")
            item_price = float(input("Item price: $"))

            self.items.append([item_name, item_price])
            self.total += item_price

            another_item = input("Add another item? (yes/no): ").lower()

            if another_item == "no":
                break

        print("Total price: $", self.total)
        
        RequisitionSystem.requisition_counter += 1
        
        self.requisition_id = RequisitionSystem.requisition_counter
        
        RequisitionSystem.all_requisition.append(self)
        
        print("Requisition ID:", self.requisition_id)
        
        return self.total
    
    def approve_requisition(self):
        
        if self.total < 500:
            self.status = "Approved"
            self.approval_reference = self.staff_id + str(self.requisition_id)[-3:]
        
        else:
            self.status = "Pending"
            self.approval_reference = "Not Available"
        
        print("Status:", self.status)
        print("Approval Reference:", self.approval_reference)
        
        return self.status
    
    def respond_requisition(self, manager_decision):
        if self.status != "Pending":
            print("The requisition is not pending")
            return
        
        if manager_decision.lower() == "approve":
            self.status = "Approved"
            self.approval_reference = self.staff_id + str(self.requisition_id)[-3:]
        
        elif manager_decision.lower() == "reject":
            self.status = "Not Approved"
            self.approval_reference = "Not Available"
        
        elif manager_decision.lower() == "pending":
            self.status = "Pending"
        
        else:
            print("Invalid manager decision")
            return

        print("Updated Status:", self.status)
        print("Approval Reference:", self.approval_reference)
        
    def display_requisitions(self):
        print("Requisition Details:")

        for requisition in RequisitionSystem.all_requisition:
            print("Date:", requisition.date)
            print("Staff ID:", requisition.staff_id)
            print("Staff name:", requisition.staff_name)
            print("Requisition ID:", requisition.requisition_id)
            print("Total: $", requisition.total)
            print("Status:", requisition.status)
            print("Approval Reference:", requisition.approval_reference)

    def requisition_statistics(self):
        total_submitted = len(RequisitionSystem.all_requisition)
        
        approved = 0
        pending = 0
        not_approved = 0
        
        for requisition in RequisitionSystem.all_requisition:
            
            if requisition.status == "Approved":
                approved += 1
            elif requisition.status == "Pending":
                pending += 1
            elif requisition.status == "Not Approved":
                not_approved += 1
        
        print("Total Submitted:", total_submitted)
        print("Approved:", approved)
        print("Pending:", pending)
        print("Not Approved:", not_approved)
        
        return total_submitted, approved, pending, not_approved

